{
  "name": "@loci/db",
  "version": "0.1.0",
  "private": true,
  "description": "LOCI360 database schema, migrations, seed and Prisma Client",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../../.env -- node prisma/seed.js",
    "admin": "dotenv -e ../../.env -- node prisma/create-admin.js",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "argon2": "^0.45.1"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "prisma": "6.19.3"
  }
}
