# LOCI360 — local configuration. `npm run env:init` copies this file to .env with fresh secrets.
# Ports are chosen so they do not clash with other projects on the same machine.

APP_URL=http://localhost:3360
API_PORT=4360
APP_SECRET=change-me
COOKIE_SECURE=false
# Proxies between the visitor and the API (1 = the web app's /api rewrite; add one per load balancer that appends X-Forwarded-For)
TRUST_PROXY=1

# PostgreSQL
POSTGRES_USER=loci
POSTGRES_PASSWORD=change-me
POSTGRES_DB=loci360
POSTGRES_PORT=54360
DATABASE_URL=postgresql://loci:change-me@localhost:54360/loci360?schema=public

# S3-compatible storage (MinIO locally; any S3 + CDN in production)
MINIO_ROOT_USER=loci
MINIO_ROOT_PASSWORD=change-me-please
MINIO_PORT=59360
MINIO_CONSOLE_PORT=59361
S3_ENDPOINT=http://localhost:59360
S3_PUBLIC_ENDPOINT=http://localhost:59360
S3_REGION=us-east-1
S3_ACCESS_KEY=loci
S3_SECRET_KEY=change-me-please
# Private: uploaded masters. Public-read: processed media served to visitors (put a CDN in front).
S3_BUCKET_ORIGINALS=loci-originals
S3_BUCKET_MEDIA=loci-media
# Base URL visitors load processed media from. In production: the CDN domain, e.g. https://cdn.loci360.kz
MEDIA_PUBLIC_URL=http://localhost:59360/loci-media

# Mail (Mailpit locally: UI on http://localhost:58360)
SMTP_HOST=localhost
SMTP_PORT=51360
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=LOCI360 <no-reply@loci360.kz>

# Web → API (server-side rendering) and API → web (cache revalidation after CMS edits)
API_INTERNAL_URL=http://localhost:4360
WEB_INTERNAL_URL=http://localhost:3360
REVALIDATE_SECRET=change-me

# Map style (MapLibre GL). OpenFreeMap is free for commercial use and needs no key.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
NEXT_PUBLIC_SITE_URL=http://localhost:3360

# Media worker
WORKER_CONCURRENCY=1
X264_PRESET=veryfast
HLS_SEGMENT_SEC=4
