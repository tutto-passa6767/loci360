{
  "name": "loci360",
  "private": true,
  "description": "LOCI360 — B2B catalogue and geo-navigator of film locations in Kazakhstan",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "stop": "node scripts/start.mjs --stop",
    "env:init": "node scripts/env-init.mjs",
    "infra:up": "docker compose up -d postgres minio minio-init mailpit",
    "infra:down": "docker compose down",
    "worker:up": "docker compose up -d --build worker",
    "db:generate": "npm run generate -w @loci/db",
    "db:migrate": "npm run migrate:dev -w @loci/db",
    "db:deploy": "npm run migrate:deploy -w @loci/db",
    "db:seed": "npm run seed -w @loci/db",
    "admin:create": "npm run admin -w @loci/db --",
    "dev:api": "npm run start:dev -w @loci/api",
    "dev:web": "npm run dev -w @loci/web",
    "build": "npm run build -w @loci/api && npm run build -w @loci/worker && npm run build -w @loci/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:e2e": "node --test --test-concurrency=1 --test-reporter=spec \"tests/e2e/*.test.mjs\""
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "unrs-resolver@1.12.2": true
  }
}
